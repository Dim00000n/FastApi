MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=FastApiDb
MSSQL_USER=sa
MSSQL_PASSWORD=change_me
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Alternatively, set one SQLAlchemy URL instead of the MSSQL_* variables:
# DATABASE_URL=mssql+pyodbc://user:password@localhost:1433/FastApiDb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
